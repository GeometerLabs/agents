# Copy this file to .env (git ignores .env) and fill in what you want to try. Names only here: never put a value in this file.
# Used by templates/commerce/bookings/standins/dev-forwarder.ts, the Phase 0 dev proxy. TEST MODE ONLY. Production keys belong to Guard, not here.

# Razorpay test mode (Dashboard -> Account & Settings -> API keys, with Test Mode switched on). The key id must start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Calendar: a ready-made access token for a TEST calendar (it lasts about an hour), and that calendar's id.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=

# WhatsApp: the Cloud API's token (or a provider sandbox's key), the phone number id to send from, and the host.
# Leave WHATSAPP_BASE_URL empty for Meta's own (https://graph.facebook.com). Set WHATSAPP_AUTH_HEADER only for a provider that wants its
# key in a header of its own (for example D360-API-KEY); the default is Authorization: Bearer.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=
WHATSAPP_AUTH_HEADER=
