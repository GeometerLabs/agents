# Copy to .env and fill in. Nothing secret goes here.
# The Guard image you were given with your licence (Guard is licensed separately and is not in a public registry).
GEO_GUARD_IMAGE=geo-guard:replace-with-your-version
# Your agent's image.
AGENT_IMAGE=registry.example.com/your-team/your-agent:1.0.0
# Optional: an image with Node 24 or newer, for the reviewers' export.
# NODE_IMAGE=node:24-alpine
