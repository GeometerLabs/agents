# The model. By default any OpenAI-compatible endpoint (Strands' OpenAI provider).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Or Amazon Bedrock instead: set MODEL_PROVIDER=bedrock, MODEL to a Bedrock model id, and AWS credentials as usual
# (pip install "strands-agents==1.62.0" boto3 is enough; the OpenAI extra is then not needed).
MODEL_PROVIDER=openai
# Your insurer's claims service (see README for the three calls it must answer).
CLAIMS_URL=https://claims.example.com
# Payments above this amount wait for an adjuster's approval id.
PAYMENT_LIMIT=1000.00
