   "source": "(?:सुबह|दोपहर|शाम|रात)\\s+\\d{1,2}:\\d{2}\\s+बजे|(?:രാവിലെ|ഉച്ചയ്ക്ക്|വൈകുന്നേരം|രാത്രി|ಬೆಳಿಗ್ಗೆ|ಮಧ್ಯಾಹ್ನ|ಸಂಜೆ|ರಾತ್ರಿ)\\s+\\d{1,2}:\\d{2}|\\d{1,2}:\\d{2}\\s*(?:am|pm)",
   "flags": "giu"
  },
  "check.trailing": {
   "source": "[.,;:!?।॥]+$",
   "flags": "u"
  },
  "check.url": {
   "source": "(?:https?:\\/\\/)?(?:[a-z0-9-]+\\.)+[a-z]{2,}\\/[^\\s)]*",
   "flags": "giu"
  },
  "check.upi": {
   "source": "upi:\\/\\/[^\\s)]*",
   "flags": "giu"
  },
  "check.amount": {
   "source": "₹\\s*(\\d[\\d,]*(?:\\.\\d+)?)",
   "flags": "gu"
  },
  "check.quantity_word": {
   "source": "(?<![\\p{L}\\p{M}\\p{N}])(?:thousand|hundred|crore|हज़ार|करोड़|lakh|हजार|लाख|सौ)(?![\\p{L}\\p{M}\\p{N}])",
   "flags": "iu"
  },
  "check.quantity_stem": {
   "source": "നൂറ|ആയിരം|ലക്ഷം|കോടി|ನೂರ|ಸಾವಿರ|ಲಕ್ಷ|ಕೋಟಿ",
   "flags": "u"
  },
  "notes.for_customers": {
   "source": "^\\s*(?:for customers|customers (?:can|may) be told|tell customers|ग्राहकों के लिए|ग्राहकों को बताना|ഉപഭോക്താക്കൾക്ക്|ಗ್ರಾಹಕರಿಗೆ)\\s*[:,\\-–]?\\s*",
   "flags": "iu"
  },
  "notes.goal": {
   "source": "^\\s*(?:my goal|goal|lakshya|लक्ष्य|ലക്ഷ്യം|ಗುರಿ)(?![\\p{L}\\p{M}\\p{N}_])",
   "flags": "iu"
  },
  "notes.instruction": {
   "source": "^\\s*(?:always|never|offer|do not|don't|please)\\b|^\\s*(?:हमेशा|कभी नहीं)",
   "flags": "iu"
  },
  "redact.email": {
   "source": "[\\p{L}\\p{N}._%+-]+@[\\p{L}\\p{N}.-]+\\.[\\p{L}]{2,}",
   "flags": "gu"
  },
  "redact.link": {
   "source": "\\b(?:https?:\\/\\/|www\\.)\\S+",
   "flags": "giu"
  },
  "redact.phone": {
   "source": "\\+?\\(?[0-9०-९൦-൯೦-೯][0-9०-९൦-൯೦-೯\\s().\\-]{8,}[0-9०-९൦-൯೦-೯]",
   "flags": "gu"
  },
  "redact.name": {
   "source": "((?<![\\p{L}\\p{M}])(?:(?:my\\s+name\\s+is|name\\s+is|name\\s*[:-]|myself|mera\\s+naam|mera\\s+name|naam)|(?:मेरा\\s+नाम|नाम)|(?:എന്റെ\\s+പേര്|എൻ്റെ\\s+പേര്|പേര്)|(?:ನನ್ನ\\s+ಹೆಸರು|ಹೆಸರು)))\\s+[\\p{L}\\p{M}][\\p{L}\\p{M}.'-]*",
   "flags": "giu"
  },
  "redact.surname": {
   "source": "^(?:\\s+[A-Z][a-z.'-]*)",
   "flags": ""
  }
 }
