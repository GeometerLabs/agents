# The model: any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Your game world's service (see README for the calls it must answer).
WORLD_URL=https://world.example.com
# Spawns above this many units wait for a game master; prices outside the range are refused.
SPAWN_LIMIT=100
MIN_PRICE=1.00
MAX_PRICE=1000.00
