# The model: any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Your game's inventory service (see README for the three calls it must answer).
INVENTORY_URL=https://inventory.example.com
# Restorations worth more gems than this wait for a game master's approval id.
GM_LIMIT=50.00
