# The model: any OpenAI-compatible endpoint, through LiteLLM.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Your company directory's service (see README for the three calls it must answer).
DIRECTORY_URL=https://directory.example.com
# Roles above this privilege level (1 viewer, 2 editor, 3 admin) wait for a security lead's approval id.
ADMIN_LEVEL=2
